# ${shlibs:Depends} only sees the libraries the executable links (libc, libm, libgcc_s). The
# graphics, input, font and D-Bus libraries are opened at run time, so they are listed by hand
# (measured with LD_DEBUG=libs; see docs/PACKAGING.md, "egui package: runtime libraries").
Depends: ${shlibs:Depends},
         ${misc:Depends},
         libwayland-client0,
         libwayland-egl1,
