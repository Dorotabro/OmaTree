<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into omatree.exe by build.rs (Windows only).

  activeCodePage UTF-8: the process's "ANSI" code page is UTF-8. Qt decodes the
  command line it is given (UTF-8, see cxx-qt-lib) with the ANSI code page, so
  without this a notebook path with an accented, Czech or other non-ASCII
  letter, passed as `omatree.exe "C:\...\poznámky.omatree"` (as Explorer does),
  arrives garbled. Needs Windows 10 version 1903 or later; on older Windows the
  setting is ignored and only non-ASCII command-line paths suffer.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
